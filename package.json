{
  "name": "crossword-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Sloth & Llama crossword name art designer (local production tool)",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "start": "node server/main.ts",
    "typecheck": "tsc -p src/core/tsconfig.json && tsc -p src/app/tsconfig.json && tsc -p server/tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
